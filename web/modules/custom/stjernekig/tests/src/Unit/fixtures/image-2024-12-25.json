  "rendered": "<div class=\"media-detail-hero__media margin-bottom-6\">\n\t\t\t\t<div class=\"wp-block-smd-block-image-rollover smd-image-rollover hds-module hds-media smd-image-rollover--clickable-indicators\"><div class=\"smd-image-rollover__alignment margin-left-auto margin-right-auto nasa-block-align-full\"><div class=\"smd-image-rollover__frame\"><img loading=\"lazy\" decoding=\"async\" width=\"5568\" height=\"3712\" src=\"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=5568&amp;h=3712&amp;fit=clip&amp;crop=faces%2Cfocalpoint\" class=\"smd-image-rollover__image smd-image-rollover__image--primary\" alt=\"A snow covered road goes up a hill to a sky filled with stars. Arcs and halos in the sky ahead appear similar to a giant eye. Please see the explanation for more detailed information.\" srcset=\"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=5568&amp;h=3712&amp;fit=crop&amp;crop=faces%2Cfocalpoint 5568w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=300&amp;h=200&amp;fit=crop&amp;crop=faces%2Cfocalpoint 300w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=768&amp;h=512&amp;fit=crop&amp;crop=faces%2Cfocalpoint 768w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=1024&amp;h=683&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1024w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=1536&amp;h=1024&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1536w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=2048&amp;h=1365&amp;fit=crop&amp;crop=faces%2Cfocalpoint 2048w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=400&amp;h=267&amp;fit=crop&amp;crop=faces%2Cfocalpoint 400w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=600&amp;h=400&amp;fit=crop&amp;crop=faces%2Cfocalpoint 600w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=900&amp;h=600&amp;fit=crop&amp;crop=faces%2Cfocalpoint 900w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=1200&amp;h=800&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1200w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960.jpg?w=2000&amp;h=1333&amp;fit=crop&amp;crop=faces%2Cfocalpoint 2000w\" sizes=\"auto, (max-width: 5568px) 100vw, 5568px\" /><img loading=\"lazy\" decoding=\"async\" width=\"5568\" height=\"3712\" src=\"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=5568&amp;h=3712&amp;fit=clip&amp;crop=faces%2Cfocalpoint\" class=\"smd-image-rollover__image smd-image-rollover__image--secondary\" alt=\"A snow covered road goes up a hill to a sky filled with stars. Arcs and halos in the sky ahead appear similar to a giant eye. Please see the explanation for more detailed information.\" srcset=\"https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=5568&amp;h=3712&amp;fit=crop&amp;crop=faces%2Cfocalpoint 5568w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=300&amp;h=200&amp;fit=crop&amp;crop=faces%2Cfocalpoint 300w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=768&amp;h=512&amp;fit=crop&amp;crop=faces%2Cfocalpoint 768w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=1024&amp;h=683&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1024w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=1536&amp;h=1024&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1536w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=2048&amp;h=1365&amp;fit=crop&amp;crop=faces%2Cfocalpoint 2048w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=400&amp;h=267&amp;fit=crop&amp;crop=faces%2Cfocalpoint 400w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=600&amp;h=400&amp;fit=crop&amp;crop=faces%2Cfocalpoint 600w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=900&amp;h=600&amp;fit=crop&amp;crop=faces%2Cfocalpoint 900w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=1200&amp;h=800&amp;fit=crop&amp;crop=faces%2Cfocalpoint 1200w, https://assets.science.nasa.gov/content/dam/science/cds/apod/apod/2024/december/IceHalos_Fous_960_annotated.jpg?w=2000&amp;h=1333&amp;fit=crop&amp;crop=faces%2Cfocalpoint 2000w\" sizes=\"auto, (max-width: 5568px) 100vw, 5568px\" /><div class=\"toggle-button-container padding-1\"><button type=\"button\" class=\"toggle-view-before-button margin-right-1px is-active\" aria-pressed=\"true\"><span class=\"toggle-view-before-label\">Image 1</span></button><button type=\"button\" class=\"toggle-view-after-button margin-left-1px\" aria-pressed=\"false\"><span class=\"toggle-view-after-label\">Image 2</span></button></div></div></div></div>\t\t\t</div>\n\t\t\n\t\t\t\t\t\t\t\t\t<h1 class=\"display-48 margin-top-0 margin-bottom-3\">Diamond Dust Sky Eye</h1>\n\t\t\t\t\t\n\t\t\t\t\t<div class=\"grid-row media-detail-hero__content-row\">\n\t\t\t\t\t\t\t\t\t<div class=\"grid-col-12 desktop:grid-col-6\">\n\t\t\t\t\t\t<p class=\"p-md margin-0 media-detail-hero__description\">\n\t\t\t\t\t\t\t<strong>Explanation:</strong> Why is there a huge eye in the sky? <a href=\"https://www.worldatlas.com/articles/what-is-diamond-dust.html\" target=\"_blank\" rel=\"noopener\">Diamond dust</a> . That is an <a href=\"https://en.wikipedia.org/wiki/Diamond_dust\" target=\"_blank\" rel=\"noopener\">informal term</a> for small ice crystals that form in the air and flitter to the ground. Because these crystals are geometrically shaped , they can together reflect light from the <a href=\"https://apod.nasa.gov/apod/ap231220.html\" rel=\"noopener\">Sun</a> or <a href=\"https://apod.nasa.gov/apod/ap200224.html\" rel=\"noopener\">Moon</a> to your eyes in a systematic way, causing huge <a href=\"https://communitycloudatlas.wordpress.com/2015/04/04/colorful-arcs-in-the-sky/\" target=\"_blank\" rel=\"noopener\">halos and unusual arcs</a> to appear. And sometimes, together the result can seem like a <a href=\"https://apod.nasa.gov/apod/ap201202.html\" rel=\"noopener\">giant eye</a> looking right back at you. In the featured image taken in the <a href=\"https://youtu.be/TcFp5j21HyE\" target=\"_blank\" rel=\"noopener\">Ore Mountains</a> of the <a href=\"https://en.wikipedia.org/wiki/Czech_Republic\" target=\"_blank\" rel=\"noopener\">Czech Republic</a> last week, a bright Moon rising through <a href=\"https://en.wikipedia.org/wiki/Fog#Freezing_conditions\" target=\"_blank\" rel=\"noopener\">ice fog</a> -filled air resulted in many of these magnificent sky illusions to be visible simultaneously. Besides <a href=\"https://apod.nasa.gov/apod/ap160321.html\" rel=\"noopener\">Moon dogs</a> , <a href=\"https://apod.nasa.gov/apod/ap180914.html\" rel=\"noopener\">tangent arcs</a> , <a href=\"https://apod.nasa.gov/apod/ap211228.html\" rel=\"noopener\">halos</a> , and a <a href=\"https://en.wikipedia.org/wiki/Parhelic_circle\" target=\"_blank\" rel=\"noopener\">parselenic circle</a> , <a href=\"https://apod.nasa.gov/apod/ap240304.html\" rel=\"noopener\">light pillars</a> above distant lights are visible on the far left, while <a href=\"https://science.nasa.gov/jupiter/\" target=\"_blank\">Jupiter</a> and <a href=\"https://science.nasa.gov/mars/\" target=\"_blank\">Mars</a> can be found just inside the bottom of the <a href=\"https://cloudatlas.wmo.int/en/22-halo.html\" target=\"_blank\" rel=\"noopener\">22-degree halo</a> .<br /><br /> Your Sky Surprise:  <a href=\"https://apod.nasa.gov/apod/calendar/allyears.html\" rel=\"noopener\">What picture did APOD feature on your birthday?</a> (post 1995) <br />\t\t\t\t\t\t</p>\n\t\t\t\t\t</div>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t<div class=\"display-none desktop:display-block desktop:grid-col-1\" aria-hidden=\"true\"></div>\n\t\t\t\t\n\t\t\t\t\t\t\t\t\t<div class=\"grid-col-12 desktop:grid-col-5 margin-top-3 desktop:margin-top-0\">\n\t\t\t\t\t\t<table class=\"media-detail-hero__meta-table width-full\">\n\t\t\t\t\t\t\t<tbody>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<tr class=\"media-detail-hero__meta-row\">\n\t\t\t\t\t\t\t\t\t\t\t<th scope=\"row\" class=\"label padding-y-1\">Date</th>\n\t\t\t\t\t\t\t\t\t\t\t<td class=\"p-sm padding-y-1\">\n\t\t\t\t\t\t\t\t\t\t\t\tDecember 25, 2024\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<tr class=\"media-detail-hero__meta-row\">\n\t\t\t\t\t\t\t\t\t\t\t<th scope=\"row\" class=\"label padding-y-1\">Credit</th>\n\t\t\t\t\t\t\t\t\t\t\t<td class=\"p-sm padding-y-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t Image Credit &amp; Copyright:  <a href=\"mailto:fousjarda at seznam dot cz\">Jaroslav Fous</a>\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<tr class=\"media-detail-hero__meta-row\">\n\t\t\t\t\t\t\t\t\t\t\t<th scope=\"row\" class=\"label padding-y-1\">Authors &amp; editors:</th>\n\t\t\t\t\t\t\t\t\t\t\t<td class=\"p-sm padding-y-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://www.mtu.edu/physics/department/faculty/nemiroff/\" target=\"_blank\" rel=\"noopener\">Robert Nemiroff</a> (<a href=\"https://www.mtu.edu/physics/\" target=\"_blank\" rel=\"noopener\">MTU</a>) &amp; <a href=\"https://inspirehep.net/authors/1073087\" target=\"_blank\" rel=\"noopener\">Jerry Bonnell</a> (<a href=\"https://www.astro.umd.edu/\" target=\"_blank\" rel=\"noopener\">UMCP</a>)\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t<tr class=\"media-detail-hero__meta-row\">\n\t\t\t\t\t\t\t\t\t\t\t<th scope=\"row\" class=\"label padding-y-1\">A service of:</th>\n\t\t\t\t\t\t\t\t\t\t\t<td class=\"p-sm padding-y-1\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"https://science.gsfc.nasa.gov/astrophysics/\" target=\"_blank\" rel=\"noopener\">ASD</a> at <a href=\"https://www.nasa.gov/\" target=\"_blank\" rel=\"noopener\">NASA</a> / <a href=\"https://www.nasa.gov/centers/goddard/\" target=\"_blank\" rel=\"noopener\">GSFC</a>,<br /><a href=\"https://science.nasa.gov/learn/about-science-activation/\" target=\"_blank\">NASA Science Activation</a> &amp; <a href=\"https://www.mtu.edu/\" target=\"_blank\" rel=\"noopener\">Michigan Tech. U.</a>\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</tbody>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t"
