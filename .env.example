# Copy to .env and adjust. Nothing in here is committed.

# Database (the db container creates this user and database on first start).
DB_NAME=stjernekig
DB_USER=stjernekig
DB_PASS=change-me
DB_HOST=stjernekig_db
DB_PORT=3306

# Drupal. Generate a salt with: openssl rand -base64 48
HASH_SALT=change-me-to-a-long-random-string

# Public hostname. Traefik routes it; Drupal trusts it.
DOMAIN_NAME=stjernekig.localhost
# Extra trusted host regexes, comma separated. Usually empty.
TRUSTED_HOST_PATTERNS=

# local | production. Local turns on verbose errors and disables caches.
DRUPAL_ENV=local

# Port published by docker-compose.local.yml.
HTTP_PORT=8095

# Admin password used by scripts/install.sh for the first install.
ADMIN_PASSWORD=admin
